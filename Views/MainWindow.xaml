<Window x:Class="Dwalia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dwalia"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="True"
        Focusable="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#221a1b26" IsHitTestVisible="False">
            <TextBlock x:Name="StatusText"
                       Text="Dwalia — Alt+Ctrl+1~9: focus | Alt+Ctrl+J/K: next/prev | Alt+Ctrl+Shift+1~5: workspace"
                       Foreground="#c0caf5"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Border x:Name="TaskBar"
                Grid.Row="1"
                Background="#5516161e"
                BorderBrush="#3b4261"
                BorderThickness="0,1,0,0"
                Height="40">
            <DockPanel VerticalAlignment="Center" Margin="8,0">
                <StackPanel x:Name="WorkspacePills" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ItemsControl x:Name="TaskBarItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="LayoutLabel" Text="MasterStack"
                           Foreground="#565f89" FontSize="11"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
