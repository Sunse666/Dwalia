<Window x:Class="Dwalia.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="600" Height="680"
        Background="#1e1e1e"
        Foreground="#cccccc"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="16"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#7aa2f7" CornerRadius="2"
                                                        Margin="0,6,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#3a3a3a" CornerRadius="2"
                                                        Margin="0,6,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" Background="#7aa2f7"
                                                        CornerRadius="7" Margin="0,1,0,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#555555" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#7aa2f7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="16" Height="16"
                                    Background="#2d2d2d" BorderBrush="#555555"
                                    BorderThickness="1" CornerRadius="3"
                                    Margin="0,0,8,0"/>
                            <Path x:Name="CheckMark" Grid.Column="0"
                                  Data="M4,8 L7,11 L12,5"
                                  Stroke="#7aa2f7" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="12" Height="10" Margin="2,0,0,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7aa2f7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7aa2f7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border Background="#1e1e1e" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1a1a1a" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="Settings" Foreground="#999999" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                        Width="32" Height="32" Background="Transparent"
                        Foreground="#999999" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCancel" FontSize="10"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#1a1a1a">
                    <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                        <TextBlock Text="Dwalia" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#cccccc" Margin="16,8,16,16"/>

                        <Button x:Name="NavGeneral" Content="General"
                                Height="36" Margin="8,0,8,2"
                                Background="#2d2d2d" Foreground="#ffffff"
                                BorderThickness="0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Click="OnNavGeneral"/>

                        <Button x:Name="NavTheme" Content="Appearance"
                                Height="36" Margin="8,0,8,2"
                                Background="Transparent" Foreground="#999999"
                                BorderThickness="0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Click="OnNavTheme"/>

                        <Button x:Name="NavLayouts" Content="Layouts"
                                Height="36" Margin="8,0,8,2"
                                Background="Transparent" Foreground="#999999"
                                BorderThickness="0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Click="OnNavLayouts"/>

                        <Button x:Name="NavWorkspaces" Content="Workspaces"
                                Height="36" Margin="8,0,8,2"
                                Background="Transparent" Foreground="#999999"
                                BorderThickness="0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Click="OnNavWorkspaces"/>

                        <Button x:Name="NavKeybindings" Content="Keybindings"
                                Height="36" Margin="8,0,8,2"
                                Background="Transparent" Foreground="#999999"
                                BorderThickness="0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Click="OnNavKeybindings"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Width="1" Background="#333333"/>

                <Grid Grid.Column="2" Margin="24,16,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="PageGeneral" Grid.Row="0" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="General" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#ffffff" Margin="0,0,0,20"/>

                            <TextBlock Foreground="#777777" FontSize="11" Margin="0,0,0,16"
                                       TextWrapping="Wrap">
                                Press Ctrl+` (backtick) to enter DWALIA command mode,
                                then use the keybindings below. Edit keybindings in
                                the Keybindings tab.
                            </TextBlock>

                            <TextBlock Text="Terminal" Foreground="#999999"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="TerminalBox" Text="wt.exe" Margin="0,0,0,20"/>

                            <TextBlock Text="Excluded processes" Foreground="#999999"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Comma-separated process names to exclude from tiling"
                                       Foreground="#777777" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="ExcludeBox" Text=""
                                     Height="60" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageTheme" Grid.Row="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#ffffff" Margin="0,0,0,20"/>

                            <TextBlock Text="Background opacity" Foreground="#999999"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100"
                                        Value="13" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Width="40" TextAlignment="Right"
                                           Foreground="#7aa2f7" VerticalAlignment="Center">
                                    <Run x:Name="BgOpacityLabel" Text="13"/><Run Text="%"/>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Taskbar opacity" Foreground="#999999"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="TbOpacitySlider" Minimum="0" Maximum="100"
                                        Value="33" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Width="40" TextAlignment="Right"
                                           Foreground="#7aa2f7" VerticalAlignment="Center">
                                    <Run x:Name="TbOpacityLabel" Text="33"/><Run Text="%"/>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Accent color" Foreground="#999999"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AccentColorBox" Text="#7aa2f7"/>
                                <Border Grid.Column="1" x:Name="AccentPreview"
                                        Width="24" Height="24" CornerRadius="4"
                                        Background="#7aa2f7" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Active border color" Foreground="#999999"
                                       Margin="0,16,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ActiveBorderBox" Text="#7aa2f7"
                                         TextChanged="OnActiveBorderChanged"/>
                                <Border Grid.Column="1" x:Name="ActiveBorderPreview"
                                        Width="24" Height="24" CornerRadius="4"
                                        Background="#7aa2f7" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Inactive border color" Foreground="#999999"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InactiveBorderBox" Text="#3b4261"
                                         TextChanged="OnInactiveBorderChanged"/>
                                <Border Grid.Column="1" x:Name="InactiveBorderPreview"
                                        Width="24" Height="24" CornerRadius="4"
                                        Background="#3b4261" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Border width" Foreground="#999999" Margin="0,16,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BorderWidthSlider" Minimum="1" Maximum="8"
                                        Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Width="45" TextAlignment="Right"
                                           Foreground="#7aa2f7" VerticalAlignment="Center">
                                    <Run x:Name="BorderWidthLabel" Text="2"/><Run Text="px"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageLayouts" Grid.Row="0" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Tiling Layouts" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#ffffff" Margin="0,0,0,12"/>
                                <TextBlock Text="Choose which layouts to cycle through with T"
                                           Foreground="#999999" Margin="0,0,0,16"/>

                                <CheckBox x:Name="ChkMasterStack" Content="MasterStack — Master left, stack right"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkMonocle" Content="Monocle — Fullscreen active window"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkGrid" Content="Grid — Equal rows and columns"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkHorizontalStack" Content="HorizontalStack — Full-width rows"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkColumns" Content="Columns — Equal-width vertical columns"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkVerticalStack" Content="VerticalStack — Master top, stack below"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkBSP" Content="BSP — Binary space partitioning"
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="Window Gaps" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#ffffff" Margin="0,24,0,12"/>

                                <TextBlock Text="Inner gap" Foreground="#999999" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="InnerGapSlider" Minimum="0" Maximum="24"
                                            Value="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" Width="45" TextAlignment="Right"
                                               Foreground="#7aa2f7" VerticalAlignment="Center">
                                        <Run x:Name="InnerGapLabel" Text="4"/><Run Text="px"/>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="Outer gap" Foreground="#999999" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OuterGapSlider" Minimum="0" Maximum="12"
                                            Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" Width="45" TextAlignment="Right"
                                               Foreground="#7aa2f7" VerticalAlignment="Center">
                                        <Run x:Name="OuterGapLabel" Text="2"/><Run Text="px"/>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="Master Area" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#ffffff" Margin="0,24,0,12"/>

                                <TextBlock Text="Master window ratio" Foreground="#999999" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MasterFactorSlider" Minimum="30" Maximum="80"
                                            Value="60" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" Width="45" TextAlignment="Right"
                                               Foreground="#7aa2f7" VerticalAlignment="Center">
                                        <Run x:Name="MasterFactorLabel" Text="60"/><Run Text="%"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="PageWorkspaces" Grid.Row="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Workspaces" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#ffffff" Margin="0,0,0,8"/>
                            <TextBlock Text="Customize workspace names shown in the taskbar"
                                       Foreground="#999999" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Workspace 1" Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="WsName1" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Workspace 2" Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="WsName2" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Workspace 3" Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="WsName3" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Workspace 4" Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="WsName4" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Workspace 5" Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="WsName5" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageKeybindings" Grid.Row="0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Keybindings" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#ffffff" Margin="0,0,0,8"/>
                            <TextBlock Text="Bindings active in DWALIA command mode. Keybinding changes apply after restart."
                                       Foreground="#999999" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                <StackPanel x:Name="KeybindingsPanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Width="80" Height="32"
                                Margin="0,0,8,0"
                                Background="#2d2d2d" Foreground="#cccccc"
                                BorderBrush="#444444" Click="OnCancel"/>
                        <Button Content="Save" Width="80" Height="32"
                                Background="#7aa2f7" Foreground="#1a1a1a"
                                BorderThickness="0" Click="OnSave"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
