<Window x:Class="Dwalia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dwalia"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="True"
        Focusable="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TaskBar"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="#3b4261"
                BorderThickness="0,0,0,1"
                Height="40">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="WorkspacePills" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                </StackPanel>
                <ItemsControl x:Name="TaskBarItems" Grid.Column="1"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border x:Name="LayoutPill" Grid.Column="2" CornerRadius="9"
                        Padding="8,2,8,2" Height="22" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,10,0"
                        Background="#44ffffff">
                    <TextBlock x:Name="LayoutLabel" Text="MasterStack"
                               Foreground="#565f89" FontSize="11"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="InfoBar"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="#3b4261"
                BorderThickness="0,0,0,1"
                Height="40"
                Visibility="Collapsed">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="InfoWorkspacePills" Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                <Border x:Name="InfoWinPill" Grid.Column="1" CornerRadius="9"
                        Padding="8,2,8,2" Height="22" VerticalAlignment="Center"
                        Background="#44ffffff" Margin="0,0,8,0" MaxWidth="360">
                    <TextBlock x:Name="InfoWinTitle"
                               Foreground="#c0caf5" FontSize="12"
                               VerticalAlignment="Center"
                               MaxWidth="340"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <Border x:Name="ClockPill" Grid.Column="2" CornerRadius="9"
                        Padding="10,2,10,2" Height="22" VerticalAlignment="Center"
                        Background="#44ffffff">
                    <TextBlock x:Name="ClockText"
                               Foreground="#c0caf5" FontSize="13"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="NetworkPill" CornerRadius="9"
                            Background="#1a1a2e" Padding="8,2,8,2"
                            Margin="0,0,6,0" Height="22">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NetDownIcon" Text="▼" FontSize="9"
                                       Foreground="#4fbf6f" VerticalAlignment="Center"
                                       Margin="0,0,3,0"/>
                            <TextBlock x:Name="NetDownText" Text="0 KB/s"
                                       Foreground="#4fbf6f" FontSize="10"
                                       VerticalAlignment="Center" FontFamily="Consolas"/>
                            <TextBlock Text=" · " Foreground="#3b4261" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetUpIcon" Text="▲" FontSize="9"
                                       Foreground="#e06c75" VerticalAlignment="Center"
                                       Margin="0,0,3,0"/>
                            <TextBlock x:Name="NetUpText" Text="0 KB/s"
                                       Foreground="#e06c75" FontSize="10"
                                       VerticalAlignment="Center" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CpuPill" CornerRadius="9"
                            Background="#1a1a2e" Padding="8,2,8,2"
                            Margin="0,0,4,0" Height="22">
                        <TextBlock x:Name="CpuText"
                                   Foreground="#e5c07b" FontSize="10"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Border>
                    <Border x:Name="MemPill" CornerRadius="9"
                            Background="#1a1a2e" Padding="8,2,8,2"
                            Margin="0,0,4,0" Height="22">
                        <TextBlock x:Name="MemText"
                                   Foreground="#61afef" FontSize="10"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Border>
                    <Border x:Name="BatteryPill" CornerRadius="9"
                            Background="#1a1a2e" Padding="8,2,8,2"
                            Margin="0,0,4,0" Height="22">
                        <TextBlock x:Name="BatteryText"
                                   Foreground="#98c379" FontSize="10"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Border>
                    <Border x:Name="MediaPill" CornerRadius="9"
                            Background="#1a1a2e" Padding="6,2,8,2"
                            Margin="0,0,4,0" Height="22" MinWidth="190">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="MediaDot" Width="8" Height="8"
                                    CornerRadius="4" Margin="0,0,5,0"
                                    Background="#4fbf6f"/>
                            <Canvas Width="210" Height="16" ClipToBounds="True">
                                <TextBlock x:Name="MediaText"
                                           Foreground="#c678dd" FontSize="10"
                                           VerticalAlignment="Center" FontFamily="Consolas">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="MediaTransform"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LauncherBar"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="#3b4261"
                BorderThickness="0,0,0,1"
                Height="40"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0">
                <StackPanel x:Name="LauncherWorkspacePills" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel x:Name="LauncherButtons"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid x:Name="OverlayGrid" Grid.Row="1"
              Background="Transparent" IsHitTestVisible="False"/>
    </Grid>
</Window>
