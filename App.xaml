<Application x:Class="Dwalia.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1a1b26"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#24283b"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7aa2f7"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#c0caf5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#565f89"/>
    </Application.Resources>
</Application>
