<Window x:Class="Dwalia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dwalia"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        Focusable="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TaskBar"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="#3b4261"
                BorderThickness="0,0,0,1"
                Height="40">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="WorkspacePills" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                </StackPanel>
                <ItemsControl x:Name="TaskBarItems" Grid.Column="1"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border x:Name="LayoutPill" Grid.Column="2" CornerRadius="9"
                        Padding="8,2,8,2" Height="22" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,10,0"
                        Background="#44ffffff">
                    <TextBlock x:Name="LayoutLabel" Text="MasterStack"
                               Foreground="#565f89" FontSize="11"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="InfoBar"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="#3b4261"
                BorderThickness="0,0,0,1"
                Height="40"
                Visibility="Collapsed"/>

        <Border x:Name="LauncherBar"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="#3b4261"
                BorderThickness="0,0,0,1"
                Height="40"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0">
                <StackPanel x:Name="LauncherWorkspacePills" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel x:Name="LauncherButtons"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid x:Name="OverlayGrid" Grid.Row="1"
              Background="Transparent" IsHitTestVisible="False"/>
    </Grid>
</Window>
